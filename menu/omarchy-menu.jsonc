  // Animated About — https://github.com/sachingubhaju/omarchy-about-animated
  // Reuse the stock ids so the About row and the logo editor reopen this build.
  "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui --app-id=org.omarchy.about $HOME/.local/bin/omarchy-about-animated"},
  "style.about.text": {"action":"omarchy-launch-editor $HOME/.config/omarchy/branding/about.txt >/dev/null 2>&1; omarchy-launch-or-focus-tui --app-id=org.omarchy.about $HOME/.local/bin/omarchy-about-animated"},
  "style.about.image": {"action":"img=$(omarchy-file-select --title \"Pick PNG or SVG for About\" --extensions \"png svg\") && omarchy-transcode-ascii \"$img\" $HOME/.config/omarchy/branding/about.txt --width 54 --height 26 && omarchy-launch-or-focus-tui --app-id=org.omarchy.about $HOME/.local/bin/omarchy-about-animated"},
  "style.about.default": {"action":"cp /usr/share/omarchy/icon.txt $HOME/.config/omarchy/branding/about.txt && omarchy-launch-or-focus-tui --app-id=org.omarchy.about $HOME/.local/bin/omarchy-about-animated"},
